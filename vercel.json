{
  "version": 2,
  "buildCommand": "npm test",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/turn.js": {
      "maxDuration": 120,
      "includeFiles": "server/**"
    },
    "api/tactical.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  }
}
